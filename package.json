{
  "name": "clarity",
  "version": "1.0.0",
  "description": "On-prem AI assistant for Grafana: ask about metrics, logs, traces and alerts with OpenAI, Anthropic, Ollama or OpenRouter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IPv4Addr/grafana-clarity.git"
  },
  "homepage": "https://github.com/IPv4Addr/grafana-clarity",
  "bugs": {
    "url": "https://github.com/IPv4Addr/grafana-clarity/issues"
  },
  "private": true,
  "author": "Stijn Timmer",
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.4",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.10",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.106.1",
    "sass-loader": "^17.1.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.2.5",
    "@grafana/runtime": "13.2.5",
    "@grafana/ui": "13.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "npm@10.9.2"
}
